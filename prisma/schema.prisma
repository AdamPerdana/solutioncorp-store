generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Product {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  name        String
  price       Int
  description String   @db.Text
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  specs      ProductSpec[]
  orderItems OrderItem[]

  @@map("products")
}

model ProductSpec {
  id        Int    @id @default(autoincrement())
  label     String
  value     String
  sortOrder Int    @default(0)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_specs")
}

model Order {
  id        Int         @id @default(autoincrement())
  name      String
  phone     String      @db.VarChar(20)
  company   String?
  region    String      @db.VarChar(30)
  address   String      @db.Text
  subtotal  Int
  status    OrderStatus @default(BARU)
  createdAt DateTime    @default(now())

  items OrderItem[]

  @@map("orders")
}

model OrderItem {
  id          Int    @id @default(autoincrement())
  productName String
  price       Int
  qty         Int

  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("order_items")
}

model Admin {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(50)
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("admins")
}

enum OrderStatus {
  BARU
  SELESAI
}


model DailyVisitor {
  visitorId String   @db.VarChar(36)
  day       String   @db.VarChar(10) // tanggal WIB, contoh: "2026-11-22"
  createdAt DateTime @default(now())

  @@id([visitorId, day])
  @@index([day])
  @@map("daily_visitors")
}